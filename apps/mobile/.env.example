# iOS Simulator can usually reach the host machine's localhost directly.
# On a physical device, replace with your machine's LAN IP, e.g.:
# EXPO_PUBLIC_API_URL="http://192.168.1.23:4000"
EXPO_PUBLIC_API_URL="http://localhost:4000"

# Google Sign-In (iOS OAuth client). Public by nature — embedded in the app
# binary. Leave unset to use the local mock sign-in flow instead. See
# apps/api/src/lib/oauth.ts for how to create this in Google Cloud Console.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID="....apps.googleusercontent.com"
