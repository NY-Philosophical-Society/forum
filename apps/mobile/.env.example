# iOS Simulator can usually reach the host machine's localhost directly.
# On a physical device, replace with your machine's LAN IP, e.g.:
# EXPO_PUBLIC_API_URL="http://192.168.1.23:4000"
EXPO_PUBLIC_API_URL="http://localhost:4000"

# Supabase Auth — the local stack's values (`supabase start` from the repo
# root); supabase/config.toml puts this project on the 544xx port block.
#
# The same LAN-IP caveat applies here, and it is easier to miss: a physical
# device cannot reach 127.0.0.1 on your machine, so sign-in fails with a
# network error while the API — already switched to the LAN IP — looks fine.
#
# The publishable key is meant to be public: it ships inside the app binary and
# grants nothing on its own, because every read and write goes through our API.
# The project's secret key must never appear here.
EXPO_PUBLIC_SUPABASE_URL="http://127.0.0.1:54421"
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH"
