// Supabase Postgres. Local development runs the stack from supabase/config.toml
// (`supabase start`); there is no SQLite path any more.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime uses the pooled connection (Supavisor, port 6543 in production)
  // with ?pgbouncer=true&connection_limit=1; migrations need the direct one.
  // Using the pooled URL for migrations is the classic mistake here.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  // This IS the Supabase auth.users id (a uuid), not a generated cuid — one
  // identity, no linking column, nothing that can drift out of sync. Supplied
  // by the API when it first sees a token (see src/server/guards.ts resolveUser),
  // never generated here. There is deliberately no foreign key to auth.users:
  // in production both live in one database, but the test suite runs against a
  // throwaway database while auth lives in the shared local stack, and not
  // modelling the FK keeps those two environments identical.
  id                  String    @id
  // Mirrored from the JWT's email claim on every authenticated request, so an
  // email changed in Supabase propagates here. Supabase owns the credential;
  // this copy exists for admin search, the directory, and DM display.
  email               String    @unique
  displayName         String
  // Public URL served by the configured StorageProvider (see
  // src/server/storage-provider.ts). Null = no photo, clients fall back to
  // initials.
  avatarUrl           String?
  bio                 String?
  verificationStatus  String    @default("UNVERIFIED")
  // "user" | "admin". No bootstrap admin UI yet — promote via direct DB
  // access (see README) until one exists.
  role                String    @default("user")
  bannedAt            DateTime?
  // Set by redeeming an access code (see routes/auth.ts redeem-code) — a
  // placeholder for the real donation/subscription API check planned once
  // this forum is gated as a member perk.
  isSupporter         Boolean   @default(false)
  supporterSince      DateTime?
  // Member directory is strictly opt-in and member-only: a user appears only
  // while directoryVisible AND isSupporter both hold, so lapsed members drop
  // out automatically without losing their saved settings.
  directoryVisible    Boolean   @default(false)
  // Short free-text interests shown in the directory (distinct from the
  // public profile bio, which stays markdown and public).
  directoryBio        String?
  // "Open to a reading partner / study group" — a directory filter, not a
  // matching algorithm; members connect by DM.
  openToPartners      Boolean   @default(false)
  // Account deletion anonymizes rather than cascade-deletes (threads/replies
  // keep rendering under "[deleted]" so other people's conversations stay
  // whole). A non-null deletedAt means the account can never log in again.
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())

  verificationSessions VerificationSession[]
  threads              Thread[]
  posts                Post[]
  threadLikes          ThreadLike[]
  postLikes            PostLike[]
  sentMessages         Message[] @relation("SentMessages")
  receivedMessages     Message[] @relation("ReceivedMessages")
  reports              Report[]
  reportsResolved      Report[]               @relation("ReportsResolved")
  moderationActions    ModerationLog[]        @relation("ModerationActions")
  blocking             Block[]                @relation("Blocker")
  blockedBy            Block[]                @relation("Blocked")
  mentionsReceived     Mention[]              @relation("MentionsReceived")
  mentionsAuthored     Mention[]              @relation("MentionsAuthored")
  notificationsReceived Notification[]        @relation("NotificationsReceived")
  notificationsActed    Notification[]        @relation("NotificationsActed")
  notificationPrefs     NotificationPreference[]
  pushTokens            PushToken[]
  bookmarks             Bookmark[]
  chapterMemberships    ChapterMembership[]
  eventAttendance       EventAttendee[]
}

// A member-only sub-forum for one local group (the NYC chapter, ...). Not a
// tag and not a board: the main feed stays a single feed, and a chapter is a
// separate access-controlled space with its own feed. Admin-created only.
model Chapter {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  // Optional: a chapter's name and city usually say enough on their own.
  description String?
  location    String?
  createdAt   DateTime @default(now())

  memberships ChapterMembership[]
  threads     Thread[]
}

// Membership is two-step for self-service: a member (isSupporter) requests to
// join ("pending") and an admin approves ("active"); an admin can also add
// someone directly (created "active"). Only "active" grants any visibility —
// every read gate in the API checks state, never mere row existence.
model ChapterMembership {
  id         String    @id @default(cuid())
  chapterId  String
  userId     String
  state      String    @default("pending")
  createdAt  DateTime  @default(now())
  approvedAt DateTime?

  chapter Chapter @relation(fields: [chapterId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([chapterId, userId])
  @@index([userId, state])
}

model VerificationSession {
  id                 String   @id @default(cuid())
  userId             String
  provider           String   @default("stub")
  providerSessionId  String
  status             String   @default("PENDING")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// Optional labels on a thread (Ethics, Metaphysics, ...). Not boards — every
// thread lives in one single feed regardless of tags; tags are just an
// optional filter on that feed.
model Tag {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  createdAt   DateTime @default(now())

  threads Thread[]
}

model Thread {
  id         String   @id @default(cuid())
  authorId   String
  title      String
  body       String
  // Recomputed and stored whenever a like/reply changes it (see
  // lib/ranking.ts) so the feed can ORDER BY this column directly instead of
  // fetching every thread and sorting in JS.
  hotScore   Float    @default(0)
  locked     Boolean  @default(false)
  // Admin pin. Deliberately NOT folded into hotScore: the feed sorts on this
  // column first, so pinning lifts a thread without distorting its ranking,
  // and unpinning restores the true order with nothing to recompute. Capped
  // at MAX_PINNED_THREADS server-side.
  pinnedAt   DateTime?
  createdAt  DateTime @default(now())
  // Set on every successful author/admin edit; clients show "edited <time>".
  editedAt   DateTime?
  // Soft delete: the row (and its replies) survive so the discussion under it
  // stays whole; serializers tombstone the title/body/author. Deleted threads
  // are excluded from the feed and profile listings.
  deletedAt  DateTime?
  // A thread belongs to either the main feed (null) or exactly one chapter —
  // never both. Chapter threads are invisible everywhere (feed, search,
  // notifications, bookmarks, profiles, direct URL) to anyone who is not an
  // active member of that chapter; admins bypass.
  chapterId  String?
  // "discussion" (default) or "event". An event thread is a club event's
  // afterlife: admin-created with a date, collects questions before, receives
  // topics/recording/transcript after. Reading follows normal rules (free
  // accounts read main-feed events); POSTING in an event is member-only.
  // If an event thread sits in a chapter, chapter visibility wins.
  kind       String   @default("discussion")
  eventDate  DateTime?
  // Per-event attendance code (WISDOMKEY pattern): anyone at the event can
  // redeem it to get the "was there" marker. Stored uppercase; null = no
  // self-serve attendance for this event.
  eventCode  String?

  chapter       Chapter?       @relation(fields: [chapterId], references: [id])
  author        User           @relation(fields: [authorId], references: [id])
  tags          Tag[]
  posts         Post[]
  likes         ThreadLike[]
  mentions      Mention[]
  notifications Notification[]
  bookmarks     Bookmark[]
  attendees     EventAttendee[]
}

// Who was in the room for an event thread. Populated by an admin marking
// attendees or by the user redeeming the event's code. Drives the "was
// there" marker on that thread's posts.
model EventAttendee {
  id        String   @id @default(cuid())
  threadId  String
  userId    String
  // "admin" or "code" — how the row came to exist.
  source    String
  createdAt DateTime @default(now())

  thread Thread @relation(fields: [threadId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([threadId, userId])
}

model ThreadLike {
  id        String   @id @default(cuid())
  threadId  String
  userId    String
  createdAt DateTime @default(now())

  thread Thread @relation(fields: [threadId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([threadId, userId])
}

model Post {
  id        String   @id @default(cuid())
  threadId  String
  authorId  String
  parentId  String?
  body      String
  createdAt DateTime @default(now())
  editedAt  DateTime?
  // Soft delete keeps the reply tree intact: a deleted post with surviving
  // descendants serializes as a "[deleted]" tombstone instead of vanishing
  // and orphaning them. The body stays in the row as an audit trail but is
  // never sent to clients once deletedAt is set.
  deletedAt DateTime?

  thread        Thread         @relation(fields: [threadId], references: [id])
  author        User           @relation(fields: [authorId], references: [id])
  likes         PostLike[]
  mentions      Mention[]
  notifications Notification[]
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

// Direct messages. Deliberately no separate "Conversation" table — a
// conversation between two users is just their messages to each other,
// queried by (senderId, recipientId) pairs. Simpler for a 1:1-only prototype;
// revisit if group DMs are ever needed.
model Message {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  body        String
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  sender    User @relation("SentMessages", fields: [senderId], references: [id])
  recipient User @relation("ReceivedMessages", fields: [recipientId], references: [id])
}

// A user reporting a thread, a post, a message, or another user. Triaged from
// the admin dashboard (/admin/reports on web) via GET /api/reports and the
// resolve/dismiss routes; resolving performs the action and closes the report
// in one call, so a report can't be marked handled without its action running.
model Report {
  id         String   @id @default(cuid())
  reporterId String
  targetType String
  targetId   String
  // A ReportCategory from packages/shared. Rows filed before categories
  // existed default to "other", keeping their original text as the note.
  category   String   @default("other")
  // The reporter's optional free-text note. Still named `reason` in the
  // column so pre-category rows carry their text through unchanged; the API
  // and both clients call this field `note`.
  reason     String?
  status     String   @default("open")
  createdAt  DateTime @default(now())
  // Who closed it and how. resolutionAction is a ReportAction; the note is
  // the mandatory reason, mirrored into the moderation log.
  resolvedById     String?
  resolvedAt       DateTime?
  resolutionAction String?
  resolutionNote   String?

  reporter   User  @relation(fields: [reporterId], references: [id])
  resolvedBy User? @relation("ReportsResolved", fields: [resolvedById], references: [id])

  @@index([status, createdAt])
}

// The accountability record for the Society's board: one row per admin
// mutation, written only through lib/moderation-log.ts logModeration() so a
// new endpoint can't quietly skip it. Append-only by construction — nothing
// in the API updates or deletes a row here, and the UI is read-only.
model ModerationLog {
  id          String   @id @default(cuid())
  // The acting admin.
  actorId     String
  // A ModerationAction from packages/shared.
  action      String
  targetType  String
  targetId    String
  // Human label captured at action time (thread title, member name), so the
  // entry still reads sensibly once the target is deleted or renamed.
  targetLabel String?
  reason      String?
  // JSON blob of action-specific detail, e.g. {"reportId":"..."}.
  detail      String?
  createdAt   DateTime @default(now())

  actor User @relation("ModerationActions", fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([targetType, targetId])
}

// Blocking prevents new messages in either direction; it does not hide
// existing history or forum posts/threads (that's what Report is for).
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id])
  blocked User @relation("Blocked", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
}

// A structural record of "@Display Name" mentions, parsed from thread/post
// bodies on create and edit (see lib/mentions.ts) — brief 05 turns these
// into notifications, and re-parsing prose later would be fragile. Exactly
// one of threadId/postId is set: where the mention appears (a thread row
// means the opening post). Rows are re-synced on edit and removed when the
// containing content is deleted, so a row here is always a live mention.
model Mention {
  id        String   @id @default(cuid())
  // The mentioned user.
  userId    String
  // Who wrote the mention. Never equal to userId (self-mentions are skipped).
  authorId  String
  threadId  String?
  postId    String?
  createdAt DateTime @default(now())

  user   User    @relation("MentionsReceived", fields: [userId], references: [id])
  author User    @relation("MentionsAuthored", fields: [authorId], references: [id])
  thread Thread? @relation(fields: [threadId], references: [id])
  post   Post?   @relation(fields: [postId], references: [id])

  // One row per (user, place) no matter how many times the name appears.
  @@unique([userId, threadId])
  @@unique([userId, postId])
  @@index([userId, createdAt])
}

// One in-app notification row per event, except likes (collapsed onto one
// unread row per target — "3 people liked your reply") and DMs (one unread
// row per sender). All creation goes through lib/notifications.ts notify(),
// which owns the self/block/preference rules — and is the single place a
// chapter-visibility check lands when brief 04 introduces one. This table
// grows fastest of anything in the app; both indexes below are load-bearing
// (unread badge polls every 15s).
model Notification {
  id          String    @id @default(cuid())
  recipientId String
  // Most recent actor (the only one shown with an avatar).
  actorId     String
  // A NotificationType from packages/shared (reply_thread, like_post, ...).
  type        String
  threadId    String?
  postId      String?
  // Collapse bookkeeping: distinct actors for likes, message count for DMs.
  count       Int       @default(1)
  // JSON array of actor ids already counted, so a like → unlike → like
  // toggle can't inflate `count`. Capped in lib/notifications.ts.
  actorIds    String    @default("[]")
  // Plain-text excerpt captured when the event happened.
  snippet     String?
  readAt      DateTime?
  // Bumped when a collapsed row absorbs a new event, so it resurfaces.
  createdAt   DateTime  @default(now())

  recipient User    @relation("NotificationsReceived", fields: [recipientId], references: [id])
  actor     User    @relation("NotificationsActed", fields: [actorId], references: [id])
  thread    Thread? @relation(fields: [threadId], references: [id])
  post      Post?   @relation(fields: [postId], references: [id])

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
}

// Per-user notification switches, one row per NotificationPrefKey plus the
// "master" kill switch. Absent row = enabled; rows exist only once a user
// changes something. One toggle covers in-app and push together.
model NotificationPreference {
  id      String  @id @default(cuid())
  userId  String
  key     String
  enabled Boolean @default(true)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, key])
}

// An Expo push token for one device. Registered on login (once permission
// is granted), removed on logout. A token is unique per device, so a device
// that switches accounts is reassigned, never duplicated.
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// A saved thread. Listing filters out deleted threads at read time — and is
// where the brief-04 chapter-visibility filter must land, so a saved thread
// the user has lost access to never leaks back through their saved list.
model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  threadId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  thread Thread @relation(fields: [threadId], references: [id])

  @@unique([userId, threadId])
  @@index([userId, createdAt])
}
