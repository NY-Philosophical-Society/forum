{
  "name": "@nyps-forum/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/run-web.mjs dev",
    "test": "npm run test:client && npm run test:api",
    "test:client": "vitest run --config vitest.client.config.ts",
    "test:api": "set -a && . ./.env.local && set +a && vitest run",
    "test:api:ci": "vitest run",
    "test:browser": "playwright test",
    "test:watch": "set -a && . ./.env.local && set +a && vitest",
    "build": "prisma generate && node ../../scripts/run-web.mjs build",
    "start": "node ../../scripts/run-web.mjs start",
    "db:migrate": "set -a && . ./.env.local && set +a && prisma migrate dev --name init",
    "db:generate": "prisma generate",
    "db:seed": "set -a && . ./.env.local && set +a && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nyps-forum/shared": "0.1.0",
    "@prisma/client": "^5.20.0",
    "@supabase/supabase-js": "^2.58.0",
    "jose": "^5.9.6",
    "next": "^15.5.26",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4",
    "stripe": "^22.6.2",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.2",
    "@img/sharp-linux-x64": "0.35.3",
    "@rolldown/binding-linux-x64-gnu": "1.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "dotenv": "^16.4.5",
    "prisma": "^5.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
