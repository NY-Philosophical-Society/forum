    "db:seed": "set -a && . ./.env.local && set +a && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nyps-forum/shared": "0.1.0",
    "@prisma/client": "^5.20.0",
    "@supabase/supabase-js": "^2.58.0",
