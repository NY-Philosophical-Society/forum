NEXT_PUBLIC_API_URL="http://localhost:4000"

# Supabase Auth. These are the local stack's values (`supabase start` from the
# repo root); supabase/config.toml puts this project on the 544xx port block so
# it doesn't collide with another local Supabase project. Run `supabase status`
# if they ever drift.
#
# The publishable key is meant to be public — it ships in the browser bundle.
# It grants nothing on its own: every read and write goes through our API,
# which is where authorization is enforced. The project's *secret* key must
# never appear in this file.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54421"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH"
