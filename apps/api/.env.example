# --- Database (Supabase Postgres) ---
# These are the local stack's values (`supabase start`, see supabase/config.toml
# — this project runs on the 544xx port block, not the 543xx default).
# In production DATABASE_URL is the POOLED connection (Supavisor, port 6543)
# with ?pgbouncer=true&connection_limit=1, and DIRECT_URL is the direct
# connection on 5432. Prisma runs migrations over DIRECT_URL; pointing
# migrations at the pooled URL is the classic way to break this.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54422/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54422/postgres"

# --- Supabase Auth ---
# The API verifies incoming Supabase JWTs against SUPABASE_URL's JWKS endpoint;
# it never signs tokens of its own. The secret key is server-only — it bypasses
# every access rule, so it must never reach a client bundle. Used for the admin
# operations we still own: deleting an auth user on account deletion, and the
# seed script's demo accounts.
SUPABASE_URL="http://127.0.0.1:54421"
SUPABASE_SECRET_KEY="sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz"
# Safe to expose — it is the same key the web and mobile clients ship. The test
# suite uses it to sign users up through the real flow. Run `supabase status`
# if these values ever drift from your local stack.
SUPABASE_PUBLISHABLE_KEY="sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH"

PORT=4000

# Used to build links that point back at the web app (the local mock
# verification page). Password-reset emails are Supabase's job now.
WEB_APP_URL="http://localhost:3000"

# --- Image storage (avatars; post images in brief 03) ---
# Leave as "local" to store uploads on disk under apps/api/uploads/ and serve
# them from this API at /uploads — zero credentials, dev/demo only.
# For production, set to "s3", implement S3StorageProvider (see
# src/lib/storage-provider.ts's top comment for the exact setup steps), and
# fill in the STORAGE_S3_* variables below. The local stub refuses to run
# once any STORAGE_S3_* credential is set, so it can't shadow a real bucket.
STORAGE_PROVIDER="local"
# STORAGE_S3_BUCKET=""
# STORAGE_S3_REGION=""              # R2: "auto"
# STORAGE_S3_ENDPOINT=""            # R2: https://<account-id>.r2.cloudflarestorage.com; unset for AWS
# STORAGE_S3_ACCESS_KEY_ID=""
# STORAGE_S3_SECRET_ACCESS_KEY=""
# STORAGE_S3_PUBLIC_URL=""          # base URL the bucket/CDN serves objects at

# The URL clients fetch this API (and locally-stored uploads) from. Set to
# your machine's LAN IP when testing the mobile app on a physical device
# (e.g. http://192.168.1.23:4000), matching EXPO_PUBLIC_API_URL.
# API_PUBLIC_URL="http://localhost:4000"

# --- Identity verification (Stripe Identity) ---
# Leave unset to use the built-in local stub provider (auto-approves after a
# few seconds, no real ID check — dev/demo only).
# Set to "stripe" once you have a Stripe account and have completed Stripe
# Identity onboarding, then fill in STRIPE_SECRET_KEY and
# STRIPE_WEBHOOK_SECRET below.
VERIFICATION_PROVIDER="stub"
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Push notifications (Expo push service) ---
# Leave as "stub" to log pushes to the console instead of sending — zero
# credentials, local dev only. Real delivery needs an Apple Developer account
# with an APNs key (and an FCM key for Android) uploaded to your Expo project,
# plus an Expo access token (https://expo.dev/settings/access-tokens) — see
# src/lib/push-provider.ts's top comment. The stub refuses to run once
# EXPO_ACCESS_TOKEN is set, so it can't silently swallow production pushes.
PUSH_PROVIDER="stub"
# EXPO_ACCESS_TOKEN=""

# --- Google / Apple sign-in ---
# Leave both unset to use the built-in dev-mock OAuth flow (lets you exercise
# the "Continue with Google/Apple" UI without real credentials — never a
# substitute for the real thing, and it refuses to run once real credentials
# are set below). See apps/api/src/lib/oauth.ts for setup steps.
# GOOGLE_WEB_CLIENT_ID="....apps.googleusercontent.com"
# GOOGLE_IOS_CLIENT_ID="....apps.googleusercontent.com"
# APPLE_SERVICES_ID="org.nyphilosophy.forum.web"
# APPLE_BUNDLE_ID="org.nyphilosophy.forum"
