# SQLite local dev DB. Point at a real Postgres URL in production.
DATABASE_URL="file:./dev.db"

# Change this to a long random string in production. Used to sign session JWTs.
JWT_SECRET="dev-only-secret-change-me"

PORT=4000

# Used to build links that point back at the web app: the local mock
# verification page, and the password-reset link (see routes/auth.ts — no
# real email service is configured, so that link is logged/returned directly
# in dev instead of being emailed).
WEB_APP_URL="http://localhost:3000"

# --- Identity verification (Stripe Identity) ---
# Leave unset to use the built-in local stub provider (auto-approves after a
# few seconds, no real ID check — dev/demo only).
# Set to "stripe" once you have a Stripe account and have completed Stripe
# Identity onboarding, then fill in STRIPE_SECRET_KEY and
# STRIPE_WEBHOOK_SECRET below.
VERIFICATION_PROVIDER="stub"
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Google / Apple sign-in ---
# Leave both unset to use the built-in dev-mock OAuth flow (lets you exercise
# the "Continue with Google/Apple" UI without real credentials — never a
# substitute for the real thing, and it refuses to run once real credentials
# are set below). See apps/api/src/lib/oauth.ts for setup steps.
# GOOGLE_WEB_CLIENT_ID="....apps.googleusercontent.com"
# GOOGLE_IOS_CLIENT_ID="....apps.googleusercontent.com"
# APPLE_SERVICES_ID="org.nyphilosophy.forum.web"
# APPLE_BUNDLE_ID="org.nyphilosophy.forum"
