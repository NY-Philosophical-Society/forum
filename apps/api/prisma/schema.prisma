// Local prototype uses SQLite for zero-setup dev. Swap provider to "postgresql"
// and set DATABASE_URL to a real connection string for production.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  // Null for accounts created via Google/Apple sign-in, which have no password.
  passwordHash        String?
  // Set only for accounts created via that provider's sign-in.
  googleId            String?   @unique
  appleId             String?   @unique
  displayName         String
  // Public URL served by the configured StorageProvider (see
  // src/lib/storage-provider.ts). Null = no photo, clients fall back to
  // initials.
  avatarUrl           String?
  bio                 String?
  verificationStatus  String    @default("UNVERIFIED")
  // "user" | "admin". No bootstrap admin UI yet — promote via direct DB
  // access (see README) until one exists.
  role                String    @default("user")
  bannedAt            DateTime?
  // Set by redeeming an access code (see routes/auth.ts redeem-code) — a
  // placeholder for the real donation/subscription API check planned once
  // this forum is gated as a member perk.
  isSupporter         Boolean   @default(false)
  supporterSince      DateTime?
  // Account deletion anonymizes rather than cascade-deletes (threads/replies
  // keep rendering under "[deleted]" so other people's conversations stay
  // whole). A non-null deletedAt means the account can never log in again.
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())

  verificationSessions VerificationSession[]
  threads              Thread[]
  posts                Post[]
  threadLikes          ThreadLike[]
  postLikes            PostLike[]
  sentMessages         Message[] @relation("SentMessages")
  receivedMessages     Message[] @relation("ReceivedMessages")
  reports              Report[]
  blocking             Block[]                @relation("Blocker")
  blockedBy            Block[]                @relation("Blocked")
  passwordResetTokens  PasswordResetToken[]
}

model VerificationSession {
  id                 String   @id @default(cuid())
  userId             String
  provider           String   @default("stub")
  providerSessionId  String
  status             String   @default("PENDING")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// Optional labels on a thread (Ethics, Metaphysics, ...). Not boards — every
// thread lives in one single feed regardless of tags; tags are just an
// optional filter on that feed.
model Tag {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  createdAt   DateTime @default(now())

  threads Thread[]
}

model Thread {
  id         String   @id @default(cuid())
  authorId   String
  title      String
  body       String
  // Recomputed and stored whenever a like/reply changes it (see
  // lib/ranking.ts) so the feed can ORDER BY this column directly instead of
  // fetching every thread and sorting in JS.
  hotScore   Float    @default(0)
  locked     Boolean  @default(false)
  createdAt  DateTime @default(now())

  author User         @relation(fields: [authorId], references: [id])
  tags   Tag[]
  posts  Post[]
  likes  ThreadLike[]
}

model ThreadLike {
  id        String   @id @default(cuid())
  threadId  String
  userId    String
  createdAt DateTime @default(now())

  thread Thread @relation(fields: [threadId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([threadId, userId])
}

model Post {
  id        String   @id @default(cuid())
  threadId  String
  authorId  String
  parentId  String?
  body      String
  createdAt DateTime @default(now())

  thread Thread     @relation(fields: [threadId], references: [id])
  author User       @relation(fields: [authorId], references: [id])
  likes  PostLike[]
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

// Direct messages. Deliberately no separate "Conversation" table — a
// conversation between two users is just their messages to each other,
// queried by (senderId, recipientId) pairs. Simpler for a 1:1-only prototype;
// revisit if group DMs are ever needed.
model Message {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  body        String
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  sender    User @relation("SentMessages", fields: [senderId], references: [id])
  recipient User @relation("ReceivedMessages", fields: [recipientId], references: [id])
}

// A user reporting a thread, a post, a message, or another user. No admin UI
// to review these yet — GET /api/reports (admin-only) lists them for now.
model Report {
  id         String   @id @default(cuid())
  reporterId String
  targetType String
  targetId   String
  reason     String
  status     String   @default("open")
  createdAt  DateTime @default(now())

  reporter User @relation(fields: [reporterId], references: [id])
}

// Blocking prevents new messages in either direction; it does not hide
// existing history or forum posts/threads (that's what Report is for).
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id])
  blocked User @relation("Blocked", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
}

// No email service is configured (see routes/auth.ts), so the reset link is
// surfaced directly in the API response / server logs in dev instead of
// being emailed — never do that in production.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}
