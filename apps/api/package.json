{
  "name": "@nyps-forum/api",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --target=node20 --packages=external --outfile=dist/index.js",
    "start": "node dist/index.js",
    "db:up": "tsx scripts/local-postgres.ts start",
    "db:down": "tsx scripts/local-postgres.ts stop",
    "db:status": "tsx scripts/local-postgres.ts status",
    "db:nuke": "tsx scripts/local-postgres.ts nuke",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nyps-forum/shared": "0.1.0",
    "@prisma/client": "^5.20.0",
    "apple-signin-auth": "^2.1.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.1",
    "google-auth-library": "^10.9.1",
    "jsonwebtoken": "^9.0.2",
    "sharp": "^0.35.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.15",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "17.10.0-beta.17",
    "esbuild": "^0.28.1",
    "pg": "^8.22.0",
    "prisma": "^5.20.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
